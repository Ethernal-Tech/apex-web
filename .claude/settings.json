{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(golangci-lint run)",
      "Bash(go test ./...)",
      "Bash(go test -race ./...)",
      "Bash(go run golang.org/x/vuln/cmd/govulncheck@v1.9.0 ./...)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env*.example)",
      "Read(!.env*.sample)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env*.example)",
      "Edit(!.env*.sample)"
    ]
  },
  "enabledPlugins": {
    "core@ethernal": true,
    "go@ethernal": true,
    "typescript@ethernal": true
  },
  "extraKnownMarketplaces": {
    "ethernal": {
      "source": {
        "source": "github",
        "repo": "Ethernal-Tech/claude-playbook"
      },
      "autoUpdate": true
    }
  }
}
