{
  "schemaVersion": 1,
  "renderedWith": "0.10.0",
  "answers": {
    "tier": "harness",
    "plugins": [
      "go",
      "typescript"
    ],
    "superpowers": false,
    "marketplace": "github",
    "profile": "standard",
    "gateFast": "(cd cardano-api && golangci-lint run && go test ./...)",
    "gateFull": "(cd cardano-api && golangci-lint run && go test -race ./... && go run golang.org/x/vuln/cmd/govulncheck@v1.9.0 ./...)",
    "gateFastQuiet": null,
    "gateFullQuiet": null,
    "sourceGlobs": [
      "cardano-api/**",
      "web-api/src/**",
      "frontend/src/**"
    ],
    "onEdit": [],
    "requiredChecks": [
      "Run lint cardano-api",
      "Run lint frontend",
      "Run lint web-api",
      "Run Cardano-API Unit Tests"
    ],
    "authGlobs": [],
    "merge": "auto",
    "signedCommits": false,
    "delivery": "none",
    "deliveryBranch": "current",
    "issues": {
      "trackers": [
        "github",
        "jira"
      ],
      "jiraKeys": [
        "AD",
        "APEX"
      ]
    },
    "protectedBranches": [
      "main"
    ],
    "commitScopes": [],
    "model": "default",
    "effort": "default",
    "mcp": false,
    "stackPlanned": {
      "frontend": null,
      "backend": null,
      "database": null,
      "testing": null,
      "orm": null,
      "language": null,
      "kind": null,
      "router": null,
      "migrations": null
    },
    "layout": "single",
    "packageManager": "pnpm",
    "gitHook": false,
    "ciGate": false,
    "dependabot": false,
    "secretsHygiene": true,
    "release": "none",
    "releaseTriggers": [
      "release-please",
      "tag",
      "dispatch"
    ],
    "releaseBranches": [
      "main"
    ],
    "dockerRegistries": [
      "ghcr"
    ],
    "dockerPlatforms": [
      "linux/amd64",
      "linux/arm64"
    ],
    "dockerImage": "ethernal-tech/apex-web",
    "cosign": false,
    "journal": true,
    "records": false
  }
}
