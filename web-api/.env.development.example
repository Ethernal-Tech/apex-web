PORT=30000
LOG_LEVEL=debug
NODE_ENV=development

ORACLE_SKYLINE_URL=http://validator-1-skyline-partner.testnet.ethernal.work:10003
ORACLE_SKYLINE_API_KEY=
ORACLE_REACTOR_URL=http://bridge-api-testnet.apexfusion.org:10003
ORACLE_REACTOR_API_KEY=

CARDANO_API_SKYLINE_URL=http://localhost:41003
CARDANO_API_SKYLINE_API_KEY=
CARDANO_API_REACTOR_URL=http://localhost:41001
CARDANO_API_REACTOR_API_KEY=

WEB_API_API_KEYS=web_api_key_1,web_api_key_2

STATUS_UPDATE_MODES_SUPPORTED=reactor,skyline,layerzero,centralized

CENTRALIZED_API_URL=https://developers.apexfusion.org
USE_CENTRALIZED_BRIDGE=false

# Skyline gateways are read from cardano-api at startup; this is the fallback for
# as long as the oracle build serving EVM bridging addresses is not deployed, and
# can be dropped once it is. The native token wallet is never configured - it is
# always read off the chain, via the gateway's predicate - so every EVM chain in
# the skyline settings needs an EVM_RPC_URLS entry below.
SKYLINE_GATEWAY_ADDRS='nexus::0x53F9124643E3D15f8d753733C5d908CD6aA65178'
REACTOR_NEXUS_GATEWAY_ADDR=0x43Bca3122Efa14C68F9d385e3b4Da8847eca32Ba
REACTOR_NEXUS_CENTRALIZED_GATEWAY_ADDR=0xEe639cDA5D46Bd32D0013bB75f60F3E691D9839f
ETH_TX_TTL_INC=50
RECENT_INPUTS_THRESHOLD_MINUTES=5
# Node endpoint per EVM chain, one variable each. A chain with no entry here
# cannot have its native token wallet resolved, so it is not bridgeable.
EVM_RPC_URL_NEXUS=https://rpc.nexus.testnet.apexfusion.org
EVM_RPC_URL_POLYGON=https://polygon-amoy.drpc.org
EVM_RPC_URL_KATANA=https://rpc-bokuto.katanarpc.com
EVM_RPC_URL_ETHEREUM=https://ethereum-sepolia-rpc.publicnode.com
EVM_RPC_URL_SEI=https://evm-rpc-testnet.sei-apis.com
EVM_RPC_URL_ARBITRUM=https://sepolia-rollup.arbitrum.io/rpc
EVM_RPC_URL_SCROLL=https://scroll-sepolia-rpc.publicnode.com
EVM_RPC_URL_UNICHAIN=https://sepolia.unichain.org
SOLANA_RPC_URL=https://api.devnet.solana.com
# Holder of locked funds on solana, until the oracle serves an address for it.
SOLANA_HOLDER_ADDRS='solana::ANxnXT2pPrkJQQzzZCaQ8AizkfhBrywPdb3airF3cqG9'

IS_MAINNET=false

TX_VALIDITY_PERIOD=30000
HASH_SECRET=1234whatever

DB_HOST='localhost'
DB_PORT=5432
DB_USERNAME=''
DB_PASSWORD=''
DB_NAME=''
DB_SSL=false

SMTP_HOST=''
SMTP_PORT=465
SMTP_USER=''
SMTP_PASS=''
CONTACT_EMAIL=''

LAYERZERO_API_URL=''
LAYERZERO_SCAN_URL='https://scan-testnet.layerzero-api.com/v1'
LAYERZERO_APIKEY=''
LAYERZERO_CONFIG="nexus::0x9208d82F121806A34a39bB90733b4C5c54F3993e::30384::London,base::0x9208d82F121806A34a39bB90733b4C5c54F3993e::30184::London,bsc::0x9208d82F121806A34a39bB90733b4C5c54F3993e::30102::Legacy"

# token prices - all optional, defaults shown
#COINGECKO_API_URL=https://api.coingecko.com/api/v3
#COINGECKO_API_KEY=
#DEFILLAMA_API_URL=https://coins.llama.fi
#TOKEN_PRICE_PROVIDERS=coingecko,defillama
#TOKEN_PRICE_REQUEST_TIMEOUT_MS=10000
#TOKEN_PRICE_STALENESS_MINUTES=60
# path to the tracked tokens list; defaults to appConfig/config/trackedTokens.json.
# point it at a mounted file to add/remove tracked tokens without a rebuild
#TRACKED_TOKENS_PATH=/etc/apex/trackedTokens.json
